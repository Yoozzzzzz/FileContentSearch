{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileContentSearch",
  "version": "0.1.0",
  "identifier": "local.filecontentsearch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "FileContentSearch", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 500 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false }
}
